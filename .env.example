# Copy this file to .env and fill in your keys.
# The app auto-loads .env on startup.

# Google Custom Search
GOOGLE_API_KEY=
GOOGLE_CX=

# Bing Search v7
BING_API_KEY=

# Optional. Claims are checked against Google News and Wikipedia without any key.
# Wikimedia gives clients that identify themselves higher rate limits: put a
# contact here (a URL or an email address), e.g. https://github.com/you
WIKIMEDIA_CONTACT=
